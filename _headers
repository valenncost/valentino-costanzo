# Caché del navegador (Cloudflare). Imágenes: 1 semana. CSS y JS: siempre se revisa si hay versión nueva.
/img/*
  Cache-Control: public, max-age=604800
/proyectos/*
  Cache-Control: public, max-age=604800
/logos-herramientas/*
  Cache-Control: public, max-age=604800
/*.png
  Cache-Control: public, max-age=604800
/*.svg
  Cache-Control: public, max-age=604800
/*.css
  Cache-Control: public, max-age=0, must-revalidate
/*.js
  Cache-Control: public, max-age=0, must-revalidate
